[Unit]
Description=Jastip Management Next.js Production Service
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/bahy/aibrain/jastip-management
ExecStart=/home/bahy/.nvm/versions/node/v22.17.1/bin/npm run start
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PATH=/home/bahy/.nvm/versions/node/v22.17.1/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
